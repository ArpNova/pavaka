{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure pavaka",
            "type": "process",
            "command": "/usr/bin/cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Compile pavakac",
            "type": "process",
            "command": "/usr/bin/cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "Configure pavaka"
        },
        {
            "label": "Run pavakac",
            "type": "process",
            "command": "${workspaceFolder}/build/pavakac",
            "args": [
                "test.pavaka",
                "-o",
                "pavaka"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Compile pavakac"
        },
        {
            "label": "Build and Run pavaka",
            "dependsOn": "Run pavakac",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}