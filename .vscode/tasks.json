{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure void",
            "type": "process",
            "command": "/usr/bin/cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Compile void",
            "type": "process",
            "command": "/usr/bin/cmake",
            "args": [
                "--build",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "dependsOn": "Configure void"
        },
        {
            "label": "Run void",
            "type": "process",
            "command": "${workspaceFolder}/build/void",
            "args": [
                "test.pn"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "dependsOn": "Compile void"
        },
        {
            "label": "Build and Run void",
            "dependsOn": "Run void",
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}