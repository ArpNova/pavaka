{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug pavakac",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/pavakac",
            "args": [
                "test.pavaka",
                "-o",
                "pavaka"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Compile pavakac"
        }
    ]
}