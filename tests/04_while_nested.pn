// Test 4: Nested while loops with inner break and continue
let int i = 0;
let int total_pairs = 0;

while (i < 3) {
    let int j = 0;
    while (j < 4) {
        if (j == 1) {
            j = j + 1;
            continue; // Skip j == 1
        }
        if (j == 3) {
            break; // Break inner loop at j == 3
        }

        print("Pair (" $(i) ", " $(j) ")");
        total_pairs = total_pairs + 1;
        j = j + 1;
    }
    i = i + 1;
}

print("Total pairs processed: " $(total_pairs));
exit(total_pairs); // For each i in {0, 1, 2}, j runs for 0 and 2 => 2 pairs each => 6 pairs
