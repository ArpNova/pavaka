// Vector demonstrations for int, char, and string
let vector<int> nums = {10, 20, 30};
nums.push_back(40);
nums.push_back(50);
nums[1] = 99;
nums.pop_back();
print("Int Vector: " $(nums) ", size: " $(nums.size()) ", element at 1: " $(nums[1]));

let vector<char> letters = {'p', 'a', 'v', 'a', 'k', 'a'};
letters.push_back('!');
print("Char Vector: " $(letters) ", first char: " $(letters[0]));

let vector<string> words = {"Welcome", "to", "Pavaka"};
words.push_back("Vectors!");
words[2] = "Pavaka Lang";
print("String Vector: " $(words));

